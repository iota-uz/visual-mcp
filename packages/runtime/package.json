{
  "name": "@visual-canvas/runtime",
  "version": "0.2.0-dev",
  "description": "Rendering runtime: HTML+Tailwind v4 / D2 / ApexCharts -> PNG, SVG, PDF, HTML. Transport- and backend-agnostic.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@tailwindcss/cli": "^4.3.2",
    "@terrastruct/d2": "^0.1.33",
    "apexcharts": "^4.5.0",
    "playwright": "1.62.1",
    "sharp": "^0.34.1",
    "tailwindcss": "^4.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
