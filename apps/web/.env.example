# The deployment URL from `npx convex dashboard` / `npx convex dev`'s output.
VITE_CONVEX_URL=https://giddy-retriever-468.convex.cloud

# A Google OAuth 2.0 Web application client ID (console.cloud.google.com ->
# APIs & Services -> Credentials). Must match GOOGLE_OAUTH_CLIENT_ID set on
# the Convex deployment (npx convex env set GOOGLE_OAUTH_CLIENT_ID ...) —
# same value, two places, because Convex verifies the token's `aud` against
# its own copy and never sees this one directly.
VITE_GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
