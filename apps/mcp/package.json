{
  "name": "@visual-canvas/mcp",
  "version": "0.1.0-dev",
  "description": "Stateless MCP transport and tool runtime for Visual Canvas.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@visual-canvas/canvas": "*",
    "@visual-canvas/runtime": "*",
    "aws4fetch": "^1.0.20",
    "convex": "1.45.0",
    "hono": "4.13.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
