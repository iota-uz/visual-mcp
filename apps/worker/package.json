{
  "name": "@visual-canvas/worker",
  "version": "0.1.0-dev",
  "description": "Render worker (PLAN.md section 3, 5): Playwright/Chromium, D2, Tailwind CLI, run_code — everything Convex's own runtime can't run. Deployed separately (Railway); talks to Convex only via short-lived, credential-free per-canvas URLs.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@remotion/bundler": "4.0.523",
    "@remotion/renderer": "4.0.523",
    "@visual-canvas/runtime": "*",
    "@visual-canvas/video": "*",
    "hono": "4.13.7",
    "pdf-lib": "^1.17.1",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.523",
    "sharp": "^0.35.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "19.2.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
