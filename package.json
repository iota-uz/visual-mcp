{
  "name": "visual-canvas",
  "version": "0.2.0-dev",
  "description": "Hosted visual canvas service for @iota.uz — Claude authors canvases and artifacts over a remote MCP endpoint; humans browse, view, and share them.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "convex"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "eval:production-ui": "node evals/production-ui/run.mjs",
    "eval:routing": "node evals/production-ui/routing-run.mjs",
    "eval:pairwise": "node evals/production-ui/pairwise.mjs",
    "eval:certify": "node evals/production-ui/certify.mjs",
    "eval:test": "node --test evals/production-ui/*.test.mjs",
    "convex:dev": "convex dev",
    "convex:push": "npm run build -w packages/canvas -w packages/runtime && convex dev --once",
    "dev:agent": "node scripts/dev-agent.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/migrations": "^0.3.6",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/workpool": "^0.4.0",
    "aws4fetch": "^1.0.20",
    "convex": "1.45.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^22.13.0",
    "jose": "^6.2.8",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "zod": "^3.24.0"
    }
  }
}
