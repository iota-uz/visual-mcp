{
  "name": "visual-canvas",
  "version": "0.2.0-dev",
  "description": "Hosted visual canvas service for @iota.uz — Claude authors canvases and artifacts over a remote MCP endpoint; humans browse, view, and share them.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "convex"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "convex:dev": "convex dev",
    "dev:agent": "node scripts/dev-agent.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@convex-dev/auth": "^0.0.95",
    "@modelcontextprotocol/server": "2.0.0",
    "convex": "1.43.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^22.13.0",
    "jose": "^6.2.8",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "zod": "^3.24.0"
    }
  }
}
